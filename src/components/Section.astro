---
interface Props {
  eyebrow: string;
  heading: string;
  id?: string;
  // Homepage sections alternate white/beige by design — not a mistake.
  background?: 'white' | 'beige';
}

const { eyebrow, heading, id, background = 'white' } = Astro.props;
---

<section class={`section section--${background}`} id={id}>
  <div class="section__content">
    <header class="section__header">
      <span class="section__eyebrow">{eyebrow}</span>
      <h2 class="section__heading">{heading}</h2>
    </header>
    <slot />
  </div>
</section>

<style>
  .section {
    padding: 96px 16px;
    /* scroll-margin-top = fixed header height + offset + gap (clears Header.astro) */
    scroll-margin-top: 96px;
  }

  @media (max-width: 1024px) {
    .section {
      padding: 64px 16px;
    }
  }

  @media (max-width: 640px) {
    .section {
      padding: 48px 16px;
      scroll-margin-top: 128px;
    }

    .section__content {
      gap: 28px;
    }
  }

  .section--white {
    background: var(--color-surface);
  }
  .section--beige {
    background: var(--color-bg);
  }

  .section__content {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .section__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }

  .section__eyebrow {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-base-sm);
    color: var(--color-muted);
  }

  .section__heading {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-4xl);
    color: var(--color-ink);
  }
</style>
