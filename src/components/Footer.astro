---
// Icons are generic outline SVGs, not extracted from Figma.
---

<footer class="footer" id="contact">
  <div class="footer__top">
    <div class="footer__brand">
      <a href="/" aria-label="Jan Prchal — home">
        <img src="/logo-white.svg" alt="" width="36" height="36" />
      </a>
      <p class="footer__tagline">Let&rsquo;s build something well-crafted.</p>
      <p class="footer__location">Hradec Králové, CZ &middot; Open to remote / hybrid</p>
    </div>

    <div class="footer__connect">
      <span class="footer__eyebrow">CONNECT</span>

      <a class="footer__link" href="mailto:prchal.honzak@gmail.com">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 4h12v8H2V4Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
          <path d="m2 4 6 5 6-5" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
        </svg>
        prchal.honzak@gmail.com
      </a>

      <a class="footer__link" href="https://github.com/janprchal" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.48c-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.17-.89-1.17-.72-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.96 0-.88.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.22 2.2.83a7.6 7.6 0 0 1 4 0c1.53-1.05 2.2-.83 2.2-.83.44 1.11.16 1.93.08 2.13.52.56.83 1.27.83 2.15 0 3.08-1.87 3.75-3.66 3.95.29.25.54.74.54 1.5v2.22c0 .21.15.46.55.38A8 8 0 0 0 8 0Z" fill="currentColor"/>
        </svg>
        GitHub
      </a>

      <a class="footer__link" href="https://linkedin.com/in/prchaljan" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3.5 5.5h2v7h-2v-7Zm1-3a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4ZM7.5 5.5h1.9v1h.03c.27-.5.92-1 1.9-1 2 0 2.4 1.3 2.4 3v4h-2v-3.5c0-.85 0-1.9-1.15-1.9-1.15 0-1.33.9-1.33 1.85v3.55h-2v-7Z" fill="currentColor"/>
        </svg>
        LinkedIn
      </a>

      <a class="footer__link" href="/cv">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M4 1.5h5.5L12 4v10.5H4v-13Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
          <path d="M9.5 1.5V4H12" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
        </svg>
        CV &#8599;
      </a>
    </div>
  </div>

  <div class="footer__divider"></div>

  <div class="footer__bottom">
    <span class="footer__copyright">&copy; 2026 Jan Prchal</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    padding: 64px 16px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    /* scroll-margin-top = fixed header height + offset + gap */
    scroll-margin-top: 96px;
  }

  @media (max-width: 640px) {
    .footer {
      padding: 48px 16px 32px;
      scroll-margin-top: 128px;
    }

    .footer__top {
      gap: 28px;
    }
  }

  .footer__top {
    width: 100%;
    max-width: 960px;
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 311px;
  }

  .footer__tagline {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-surface);
  }

  .footer__location {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-base-sm);
    color: var(--color-surface);
    opacity: 0.55;
  }

  .footer__connect {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-surface);
    opacity: 0.55;
  }

  .footer__link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-base);
    color: var(--color-surface);
    transition: opacity 0.15s ease;
  }
  .footer__link:hover,
  .footer__link:focus-visible {
    opacity: 0.75;
  }

  .footer__divider {
    width: 100%;
    max-width: 960px;
    height: 1px;
    background: var(--color-surface);
    opacity: 0.12;
  }

  .footer__bottom {
    width: 100%;
    max-width: 960px;
  }

  .footer__copyright {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-surface);
    opacity: 0.55;
  }
</style>
