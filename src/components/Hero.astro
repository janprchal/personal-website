---
/*
 * Hero section — includes Header/Nav because Figma structures them as one
 * fused "Hero Group" sharing a single grid-texture background (see
 * style.md's 2026-08-11 "Nav+Hero background merged" note), not two
 * independent sections.
 */
import Header from './Header.astro';
import Button from './Button.astro';
---

<section class="hero-group">
  <Header />

  <div class="hero">
    <div class="hero__badge" data-hero-badge>
      <span class="hero__badge-hello">Hello!</span>
      <span class="hero__badge-name">I&rsquo;m Jan Prchal</span>
    </div>

    <div class="hero__headline-wrap">
      <span class="hero__underline" data-hero-underline aria-hidden="true"></span>
      <h1 class="hero__headline" data-hero-headline>Frontend Developer</h1>
    </div>

    <p class="hero__bio" data-hero-subtext>
      Ten-plus years building interfaces with Vue.js and Angular — and designing them first. I take products from Figma mockups through to production TypeScript, HTML, and CSS.
    </p>

    <div class="hero__cta" data-hero-cta>
      <Button variant="filled" size="large" href="#projects">View projects</Button>
      <Button variant="outline" size="large" href="#contact">Get in touch</Button>
    </div>
  </div>
</section>

<script>
  import { initHeroAnimation } from '../scripts/hero-animation.js';
  initHeroAnimation();
</script>

<style>
  .hero-group {
    position: relative;
    background-color: var(--color-bg);
    background-image:
      repeating-linear-gradient(to right, color-mix(in srgb, var(--color-ink) 5%, transparent) 0 1px, transparent 1px 20px),
      repeating-linear-gradient(to bottom, color-mix(in srgb, var(--color-ink) 5%, transparent) 0 1px, transparent 1px 20px);
    padding-top: 24px;
  }

  .hero {
    max-width: 880px;
    margin: 0 auto;
    padding: 68px 16px 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
  }

  .hero__badge {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px;
    background: var(--color-surface);
    border-radius: 5px;
  }

  .hero__badge-hello {
    padding: 4px;
    background: var(--color-accent-blue);
    border-radius: 5px;
    color: var(--color-surface);
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: var(--text-xs);
  }

  .hero__badge-name {
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: var(--text-xs);
  }

  .hero__headline-wrap {
    position: relative;
    display: inline-block;
    padding: 0 8px;
  }

  .hero__underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 24px;
    background: var(--color-accent-yellow);
    transform: scaleX(1);
    transform-origin: left center;
  }

  .hero__headline {
    position: relative;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-hero);
    line-height: var(--leading-snug);
    color: var(--color-ink);
  }

  .hero__bio {
    max-width: 640px;
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--color-muted);
  }

  .hero__cta {
    display: flex;
    gap: 12px;
  }
</style>
