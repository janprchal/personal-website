---
import Card from './Card.astro';
import Avatar from './Avatar.astro';

interface Props {
  quote: string;
  name: string;
  role: string;
  avatarInitials: string;
  avatarAccent: 'yellow' | 'green' | 'blue';
  quoteMarkAccent?: 'yellow' | 'green' | 'blue';
}

const {
  quote, name, role, avatarInitials, avatarAccent,
  quoteMarkAccent = avatarAccent,
} = Astro.props;

const quoteMarkColor: Record<string, string> = {
  yellow: 'var(--color-accent-yellow)',
  green: 'var(--color-accent-green)',
  blue: 'var(--color-accent-blue)',
};
---

<Card class="testimonial-card">
  <div class="testimonial-card__body">
    <span class="testimonial-card__mark" style={`color: ${quoteMarkColor[quoteMarkAccent]}`} aria-hidden="true">&ldquo;</span>
    <p class="testimonial-card__quote">{quote}</p>
  </div>
  <div class="testimonial-card__attribution">
    <Avatar initials={avatarInitials} accent={avatarAccent} size={36} />
    <div class="testimonial-card__name">
      <span class="testimonial-card__name-text">{name}</span>
      <span class="testimonial-card__role">{role}</span>
    </div>
  </div>
</Card>

<style>
  /* See PositionCard.astro for why this must be :global() on the WHOLE
     selector, not `.testimonial-card :global(.card__inner)`. */
  :global(.testimonial-card .card__inner) {
    padding: 4px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .testimonial-card__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 24px 4px;
    flex: 1;
  }

  .testimonial-card__mark {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: var(--text-6xl);
    line-height: var(--leading-tight);
    /*
     * A "“" glyph at 60px sits near the top of its line box — measured
     * via canvas pixel-ink scan: visible ink occupies roughly the top third
     * of the box, leaving ~37px of empty space below the ink before the
     * box itself ends. That empty space stacked on top of the intended
     * 12px gap (from .testimonial-card__body's flex `gap`) is what read as
     * "too much spacing". Pulling the box's bottom edge up with a negative
     * margin (in em, so it scales if font-size ever changes) collapses
     * that unused space while keeping the visible glyph the same size.
     */
    margin-bottom: -0.6em;
  }

  .testimonial-card__quote {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--color-ink);
  }

  .testimonial-card__attribution {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    background: var(--color-attribution-bg);
  }

  .testimonial-card__name {
    display: flex;
    flex-direction: column;
  }

  .testimonial-card__name-text {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-base-sm);
    color: var(--color-ink);
  }

  .testimonial-card__role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>
