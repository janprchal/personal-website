---
import Section from '../Section.astro';
import TestimonialCard from '../TestimonialCard.astro';
---

<Section eyebrow="TESTIMONIALS" heading="What they said about me." background="beige">
  <div class="testimonials-grid">
    <div class="testimonials-row">
      <div class="testimonials-cell testimonials-cell--wide">
  
         <TestimonialCard
          quote="I worked with Jan on several design systems and applications, built in both Vue and Angular, and he’s among the best frontend developers I’ve worked with.
Jan’s SCSS is some of the cleanest I’ve seen. He builds styles that stay scalable and maintainable even in design systems complex enough to spiral into chaos in someone else’s hands. Where others rack up technical debt, he finds the elegant fix and keeps moving.
He works component by component and respects separation of concerns, and it shows in what he builds: systems that hold up on both the UX side and the technical side."
          name="Victor Espinoza"
          role="Frontend Developer, BuildingMinds"
          avatarInitials="VE"
          avatarAccent="green"
          quoteMarkAccent="green"
        />
      </div>
      <div class="testimonials-cell testimonials-cell--narrow">
             <TestimonialCard
          quote="Jan pleasantly surprised me with his proactive approach — he always understood what the client actually needed. He quickly became the lead coder behind most of our division's web projects. I can recommend him without hesitation."
          name="Zdeněk Dubnický"
          role="Digital Transformation & PM Consultant"
          avatarInitials="ZD"
          avatarAccent="yellow"
          quoteMarkAccent="green"
        />
      </div>
    </div>
    <div class="testimonials-row">
      <div class="testimonials-cell testimonials-cell--narrow">
        <TestimonialCard
          quote="Jan is, without a doubt, a master of his specialization. His attention to detail is unmatched - he turns complex designs into pixel-perfect, responsive, high-performance UIs."
          name="Michal Šajdík"
          role="Angular / React Developer"
          avatarInitials="MŠ"
          avatarAccent="yellow"
          quoteMarkAccent="green"
        />
      </div>
      <div class="testimonials-cell testimonials-cell--wide">
        <TestimonialCard
          quote="Jan is a skilled web developer with TypeScript, Angular and Vue. He is friendly, reliable and he has a very good eye for UX/UI, where he has a lot of experience. He can always find a good design solution that balances user experience with a technical solution that is not too complicated. He also has a lot of experience with building and maintaining our own Design System. And he is not afraid to speak up when something does not make sense."
          name="Jakub Žufánek"
          role="Java Developer"
          avatarInitials="JŽ"
          avatarAccent="blue"
          quoteMarkAccent="green"
        />
      </div>
    </div>
  </div>
</Section>

<style>
  .testimonials-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .testimonials-row {
    display: flex;
    gap: 24px;
    align-items: stretch;
  }

  .testimonials-cell {
    display: flex;
  }
  .testimonials-cell > :global(*) {
    width: 100%;
  }

  .testimonials-cell--wide {
    flex: 520;
  }
  .testimonials-cell--narrow {
    flex: 416;
  }

  /* Fixed-ratio cells get unreadably narrow below ~640px — stack instead. */
  @media (max-width: 640px) {
    .testimonials-row {
      flex-direction: column;
    }
  }
</style>
