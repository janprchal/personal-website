---
// Shadow lives on the outer div, overflow:hidden on the inner — combined
// on one element, overflow would clip the shadow at its own edge.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['card', className]}>
  <div class="card__inner">
    <slot />
  </div>
</div>

<style>
  .card {
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .card__inner {
    background: var(--color-surface);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
</style>
