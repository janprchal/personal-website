---
import Link from './Link.astro';
import Button from './Button.astro';

// "Contact" and separate "Experience" items were dropped — Footer's CTAs
// already cover contact intent, and Experience is part of the Skills section.
const navItems = [
  { label: 'Skills & Experience', href: '#skills' },
  { label: 'Projects', href: '#projects' },
];
---

<header class="header">
  <div class="header__card">
    <div class="header__inner">
      <a href="/" class="header__logo" aria-label="Jan Prchal — home" data-hero-logo>
        <img src="/logo.svg" alt="" width="36" height="36" />
      </a>
      <nav class="header__nav" aria-label="Primary">
        {navItems.map((item) => <Link href={item.href}>{item.label}</Link>)}
      </nav>
      <Button variant="filled" href="/cv">My resume</Button>
    </div>
  </div>
</header>

<script>
  import { initNavScrollspy } from '../scripts/nav-scrollspy.js';
  initNavScrollspy();
</script>

<style>
  .header {
    /* fixed, not sticky — sticky would be bounded by .hero-group's height
       (see Hero.astro) and scroll away for good after the Hero section. */
    position: fixed;
    top: 16px;
    left: 0;
    right: 0;
    z-index: 20;
    display: flex;
    justify-content: center;
    padding: 0 16px;
  }

  .header__card {
    width: 100%;
    max-width: 960px;
    border-radius: var(--radius-nav);
    box-shadow: var(--shadow-nav);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--color-surface);
    border-radius: var(--radius-nav);
    padding: 8px 16px;
  }

  .header__logo {
    display: flex;
    flex-shrink: 0;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  @media (max-width: 640px) {
    .header__inner {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 12px;
    }

    /* order:3 + flex-basis:100% drops nav to its own row below logo/button. */
    .header__nav {
      order: 3;
      flex-basis: 100%;
      justify-content: center;
      flex-wrap: wrap;
      gap: 16px 32px;
    }
  }
</style>
