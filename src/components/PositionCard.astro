---
import Card from './Card.astro';

// `description` is trusted HTML (bold spans on key terms) — callers must
// supply markup, never attacker-controlled input.
interface Props {
  role: string;
  dates: string;
  description: string;
  company: string;
  logo: string;
  logoAlt: string;
}

const { role, dates, description, company, logo, logoAlt } = Astro.props;
---

<Card class="position-card">
  <div class="position-card__body">
    <div class="position-card__head">
      <h3>{role}</h3>
      <span class="position-card__dates">{dates}</span>
    </div>
    <p class="position-card__description" set:html={description} />
  </div>
  <div class="position-card__attribution">
    <img class="position-card__logo" src={logo} alt={logoAlt} width="32" height="32" />
    <span class="position-card__company">{company}</span>
  </div>
</Card>

<style>
  /* Whole selector must be :global() — .card__inner carries Card.astro's
     own scope attribute, so a partial :global() never matches. */
  :global(.position-card .card__inner) {
    padding: 4px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .position-card__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 24px 4px;
  }

  .position-card__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .position-card__head h3 {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-ink);
  }

  .position-card__dates {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .position-card__description {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-ink);
    white-space: pre-line;
  }
  .position-card__description :global(strong) {
    font-weight: 700;
  }

  .position-card__attribution {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    background: var(--color-attribution-bg);
  }

  .position-card__logo {
    flex-shrink: 0;
    object-fit: contain;
  }

  .position-card__company {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-base-sm);
    color: var(--color-ink);
  }
</style>
