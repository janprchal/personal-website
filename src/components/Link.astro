---
// Underline is a hand-drawn bar (not text-decoration) so thickness/color
// are controllable; revealed via scaleX for GPU-accelerated animation.
interface Props {
  href: string;
  target?: string;
  class?: string;
}

const { href, target, class: className } = Astro.props;
---

<a
  class:list={['link', className]}
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
>
  <span class="link__label"><slot /></span>
  <span class="link__underline" aria-hidden="true"></span>
</a>

<style>
  .link {
    position: relative;
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-ink);
    transition: color 0.15s ease;
  }

  .link__underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: var(--link-underline-height);
    background: var(--color-accent-blue);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.2s ease, background-color 0.15s ease;
  }

  .link:hover,
  .link:focus-visible {
    color: var(--color-accent-blue);
  }
  .link:hover .link__underline,
  .link:focus-visible .link__underline {
    transform: scaleX(1);
    background: var(--color-accent-blue);
  }

  .link:active {
    color: var(--color-accent-blue-active);
  }
  .link:active .link__underline {
    transform: scaleX(1);
    background: var(--color-accent-blue-active);
  }

  /* Scrollspy active state (set by nav-scrollspy.js) — reuses hover styling. */
  .link[aria-current='location'] {
    color: var(--color-accent-blue);
  }
  .link[aria-current='location'] .link__underline {
    transform: scaleX(1);
    background: var(--color-accent-blue);
  }
</style>
