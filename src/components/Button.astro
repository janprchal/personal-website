---
// href renders an <a>; omit it for a <button type="button">.
interface Props {
  variant?: 'filled' | 'outline';
  size?: 'small' | 'large';
  href?: string;
  target?: string;
  class?: string;
  style?: string;
}

const { variant = 'filled', size = 'small', href, target, class: className, style } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
  type={href ? undefined : 'button'}
  style={style}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: var(--radius-button);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    transition: background-color 0.15s ease, box-shadow 0.15s ease, color 0.15s ease;
  }

  /* padding differs by 1px/4px between variants — intentional, not drift. */
  .btn--filled.btn--small { padding: 8px 12px; }
  .btn--outline.btn--small { padding: 9px 16px; }
  .btn--large { padding: 12px 24px; }

  .btn--filled {
    background: var(--color-btn-fill);
    color: var(--color-surface);
    box-shadow: var(--shadow-btn);
  }
  .btn--filled:hover {
    background: var(--color-btn-fill-hover);
    box-shadow: var(--shadow-btn-hover);
  }
  .btn--filled:active {
    background: var(--color-btn-fill-active);
    box-shadow: var(--shadow-btn-active);
  }

  /* --btn-outline-color lets a caller tint border/text without a new variant. */
  .btn--outline {
    background: var(--color-surface);
    color: var(--btn-outline-color, var(--color-ink));
    border: 1px solid var(--btn-outline-color, var(--color-ink));
    box-shadow: none;
  }
  .btn--outline:hover {
    background: var(--btn-outline-color, var(--color-ink));
    color: var(--color-surface);
    border-color: transparent;
    box-shadow: var(--shadow-btn-outline-hover);
  }
  .btn--outline:active {
    background: var(--btn-outline-color-active, var(--color-btn-fill-active));
    color: var(--color-surface);
    border-color: transparent;
    box-shadow: var(--shadow-btn-outline-active);
  }
</style>
