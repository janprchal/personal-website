---
/*
 * Filled + outline button primitive. All 4 states (default/hover/focus/
 * active) match the Figma "Interactive States Reference" card (node
 * 274:60) exactly — see tokens.css for the source values.
 *
 * variant: 'filled' (primary CTA, e.g. "My resume", "Get in touch") or
 *   'outline' (secondary CTA, e.g. "View details").
 * size: 'small' (nav/card buttons, padding 8px 12px) or 'large' (Hero's
 *   "View projects"/"Get in touch", padding 12px 24px) — confirmed as two
 *   real distinct sizes in Figma, not a drift.
 * href: renders an <a>; omit to render a <button type="button">.
 */
interface Props {
  variant?: 'filled' | 'outline';
  size?: 'small' | 'large';
  href?: string;
  target?: string;
  class?: string;
  style?: string;
}

const { variant = 'filled', size = 'small', href, target, class: className, style } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
  type={href ? undefined : 'button'}
  style={style}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: var(--radius-button);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    transition: background-color 0.15s ease, box-shadow 0.15s ease, color 0.15s ease;
  }

  /* Small outline (9px 16px, e.g. "View details") measures 1px/4px off
     small filled (8px 12px, e.g. "My resume") in Figma — two distinct
     components, not drift, so kept distinct rather than unified. */
  .btn--filled.btn--small { padding: 8px 12px; }
  .btn--outline.btn--small { padding: 9px 16px; }
  .btn--large { padding: 12px 24px; }

  .btn--filled {
    background: var(--color-btn-fill);
    color: var(--color-surface);
    box-shadow: var(--shadow-btn);
  }
  .btn--filled:hover {
    background: var(--color-btn-fill-hover);
    box-shadow: var(--shadow-btn-hover);
  }
  .btn--filled:active {
    background: var(--color-btn-fill-active);
    box-shadow: var(--shadow-btn-active);
  }

  /*
   * --btn-outline-color lets a caller tint the border/text (and hover
   * fill) without a new variant — used by the case-study pages for their
   * "Visit X" buttons, which are this same outline treatment but in each
   * project's own accent color (confirmed in Figma: same padding/radius/
   * no-shadow-at-rest as the ink-colored outline button, just a different
   * border+text color). Pass e.g. `style="--btn-outline-color: var(--cs-accent)"`.
   */
  .btn--outline {
    background: var(--color-surface);
    color: var(--btn-outline-color, var(--color-ink));
    border: 1px solid var(--btn-outline-color, var(--color-ink));
    box-shadow: none;
  }
  .btn--outline:hover {
    background: var(--btn-outline-color, var(--color-ink));
    color: var(--color-surface);
    border-color: transparent;
    box-shadow: var(--shadow-btn-outline-hover);
  }
  .btn--outline:active {
    background: var(--btn-outline-color-active, var(--color-btn-fill-active));
    color: var(--color-surface);
    border-color: transparent;
    box-shadow: var(--shadow-btn-outline-active);
  }
</style>
