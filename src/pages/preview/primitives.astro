---
// Temporary sandbox for checking primitive components against the Figma
// Interactive States Reference card while the real pages don't exist yet.
// Delete this route once Header/Footer/homepage are built (step 4/5).
import '../../styles/global.css';
import Hero from '../../components/Hero.astro';
import Footer from '../../components/Footer.astro';
import PositionCard from '../../components/PositionCard.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Primitives sandbox</title>
	</head>
	<body>
		<Hero />
		<div style="padding: 40px; display: flex; gap: 24px; align-items: flex-start; flex-wrap: wrap;">
			<div style="width: 468px;">
				<PositionCard
					role="Frontend Developer"
					dates="2024 - Present"
					description={"Developed frontend features using <strong>Angular (v18+)</strong> with <strong>TypeScript</strong>, including <strong>standalone components</strong> and <strong>signals.</strong>  Main focus on <strong>implementing UI/UX designs</strong>, with partial involvement in the design process itself. \nTook part in code reviews and agile sprints"}
					company="BuildingMinds"
					logo="/logos/buildingminds.svg"
					logoAlt="BuildingMinds"
				/>
			</div>
			<div style="width: 520px;">
				<TestimonialCard
					quote="Jan pleasantly surprised me with his proactive approach — he always understood what the client actually needed. He quickly became the lead coder behind most of our division's web projects. I can recommend him without hesitation."
					name="Zdeněk Dubnický"
					role="Digital Transformation & PM Consultant"
					avatarInitials="ZD"
					avatarAccent="yellow"
				/>
			</div>
			<div style="width: 468px;">
				<ProjectCard
					title="BuildingMinds"
					subtitle="BuildingMinds"
					description="A SaaS platform for real estate asset managers — portfolio tracking, ESG reporting, and retrofit planning in one place."
					technologies={[
						{ name: "Angular (v18+)", dotColor: "#DD0031" },
						{ name: "TypeScript", dotColor: "#3178C6" },
						{ name: "Design Systems", dotColor: "#14B8A6" },
					]}
					href="#"
					image="/images/projects/buildingminds.png"
					imageAlt=""
				/>
			</div>
			<div style="width: 468px;">
				<ProjectCard
					title="EnviSoG"
					subtitle="EnviSoG"
					description="A carbon-footprint calculator that guides companies through GHG Protocol and ISO 14064 emissions reporting — from energy use to company vehicles."
					technologies={[
						{ name: "Vue.js", dotColor: "#4FC08D" },
						{ name: "Nuxt", dotColor: "#00DC82" },
						{ name: "SCSS", dotColor: "#CC6699" },
					]}
					href="#"
					image="/images/projects/envisog.png"
					imageAlt=""
				/>
			</div>
			<div style="width: 468px;">
				<PositionCard
					role="Frontend Designer"
					dates="2016 - 2024"
					description="Worked on multiple projects for clients across Tech, Banking, Telco, and Insurance, including Zurich, Nedbank, T-Mobile, Molo Finance and more.  Used Vue.js, Figma, SCSS, and JavaScript to design and implement responsive web interfaces."
					company="Enrian Partners"
					logo="/logos/enrian.svg"
					logoAlt="Enrian Partners"
				/>
			</div>
		</div>
		<Footer />
	</body>
</html>
